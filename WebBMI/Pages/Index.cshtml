@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
    var hasBmi = float.IsFinite(Model.BmiResult) && Model.BmiResult > 0;
    var needleAngle = hasBmi ? (Math.Clamp((double)Model.BmiResult, 10, 40) - 10) * 6 - 90 : -90;
    var needleTransform = $"rotate({needleAngle.ToString(System.Globalization.CultureInfo.InvariantCulture)} 160 160)";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h5>.net core BMI example</h5>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <form method="post">
                @Html.AntiForgeryToken()
                <div class="card">
                    <span class="card-header bg-primary" style="color:white">
                        計算BMI
                    </span>
                    <div class="card-body">
                        <label>身高:</label>
                        <input name="fieldHeight" class="form-control" type="text" value="@Model.fieldHeight" />
                        <label>體重:</label>
                        <input name="fieldWeight" class="form-control" type="text" value="@Model.fieldWeight" />
                        <br />
                        <button type="submit" asp-page-handler="Calculate" class="btn btn-primary">計算</button>
                        <label>
                            BMI :  @Model.BmiResult
                        </label>
                        <div class="bmi-gauge" aria-live="polite">
                            <svg viewBox="0 0 320 205" role="img" aria-labelledby="bmi-gauge-title bmi-gauge-description">
                                <title id="bmi-gauge-title">BMI 指針儀表</title>
                                <desc id="bmi-gauge-description">@(hasBmi ? $"BMI 為 {Model.BmiResult:0.0}，儀表刻度從 10 到 40。" : "輸入身高與體重後，按計算即可顯示 BMI 指針。")</desc>
                                <path d="M 40 160 A 120 120 0 0 1 280 160" fill="none" stroke="#dbeafe" stroke-width="20" />
                                <g stroke="#475569" stroke-width="2">
                                    <path d="M 30 160 H 50 M 47.4 95 L 64.7 105 M 95 47.4 L 105 64.7 M 160 30 V 50 M 225 47.4 L 215 64.7 M 272.6 95 L 255.3 105 M 270 160 H 290" />
                                </g>
                                <g fill="#334155" font-size="13" text-anchor="middle">
                                    <text x="19" y="180">10</text>
                                    <text x="33" y="88">15</text>
                                    <text x="87" y="30">20</text>
                                    <text x="160" y="18">25</text>
                                    <text x="233" y="30">30</text>
                                    <text x="287" y="88">35</text>
                                    <text x="301" y="180">40</text>
                                </g>
                                @if (hasBmi)
                                {
                                    <g transform="@needleTransform">
                                        <path d="M 154 160 L 160 61 L 166 160 Z" fill="#1d4ed8" />
                                    </g>
                                    <circle cx="160" cy="160" r="9" fill="#1e3a8a" />
                                }
                            </svg>
                            <div class="bmi-gauge-value">@(hasBmi ? $"BMI {Model.BmiResult:0.0}" : "等待計算")</div>
                            <p class="text-muted mb-0">
                                @if (!hasBmi)
                                {
                                    @(Model.Request.Method == "POST" ? "請輸入有效的身高與體重後再計算。" : "輸入身高與體重，查看 BMI 指針。")
                                }
                                else if (Model.BmiResult < 10 || Model.BmiResult > 40)
                                {
                                    @:BMI 超出儀表範圍（10–40），指針顯示於端點。
                                }
                                else
                                {
                                    @Model.HealthDescription
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
